{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep|apply_patch|Edit|Write|spawn_agent",
        "hooks": [
          {
            "type": "command",
            "command": "tare-hook codex",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "tare-hook codex",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
