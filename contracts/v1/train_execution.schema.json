{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tare.tools/train-execution/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "train_id",
    "work_id",
    "work_graph",
    "execution_repository",
    "base_commit",
    "target_ref",
    "library_manifest",
    "tracked_paths",
    "verification_checks"
  ],
  "properties": {
    "schema": {"const": "tare.tools/train-execution/1"},
    "train_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "work_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "work_graph": {"type": "string", "minLength": 1, "maxLength": 4096},
    "execution_repository": {"type": "string", "minLength": 1, "maxLength": 128},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "target_ref": {"type": "string", "pattern": "^refs/heads/"},
    "library_manifest": {"type": "string", "minLength": 1, "maxLength": 4096},
    "tracked_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096}
    },
    "verification_checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "command"],
        "properties": {
          "criterion": {"type": "string", "minLength": 1, "maxLength": 4096},
          "command": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {"type": "string", "minLength": 1, "maxLength": 4096}
          }
        }
      }
    }
  }
}
